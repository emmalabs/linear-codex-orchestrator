LINEAR_READY_LABEL=
LINEAR_RUNNING_LABEL=agent-running
LINEAR_BLOCKED_LABEL=agent-blocked
LINEAR_TODO_STATUS=Todo
LINEAR_IN_PROGRESS_STATUS=In Progress
LINEAR_IN_REVIEW_STATUS=In Review

# Workspace allowlist keyed by Linear team key.
WORKSPACE_MAP_JSON={"EMMA":{"path":"/Users/aleix.ventayol/Projects/emma","repos":{"api":{"github":"emmalabs/emma.db-api","path":"/Users/aleix.ventayol/Projects/emma/emma.db-api","base":"develop"},"app":{"github":"emmalabs/emma.db-app","path":"/Users/aleix.ventayol/Projects/emma/emma.db-app","base":"develop"},"data":{"github":"emmalabs/emma.db-data","path":"/Users/aleix.ventayol/Projects/emma/emma.db-data","base":"develop"},"docker":{"github":"emmalabs/emma.db-docker","path":"/Users/aleix.ventayol/Projects/emma/emma.db-docker","base":"develop"}}}}

# Runtime safety.
MAX_ISSUES_PER_TICK=1
LOCK_DIR=.locks
DRY_RUN=true
TEST_COMMAND=
