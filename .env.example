# Optional label gate. Leave empty to process any Todo issue.
LINEAR_READY_LABEL=
LINEAR_RUNNING_LABEL=agent-running
LINEAR_TODO_STATUS=Todo
LINEAR_IN_PROGRESS_STATUS=In Progress
LINEAR_IN_REVIEW_STATUS=In Review

# Repository allowlist. Route by Linear labels like repo:api, repo:app, repo:data, repo:docker.
REPO_MAP_JSON={"api":{"github":"emmalabs/emma.db-api","path":"/home/aleix/Projects/emma.db/emma-api","base":"develop","label":"repo:api"},"app":{"github":"emmalabs/emma.db-app","path":"/home/aleix/Projects/emma.db/emma-app","base":"develop","label":"repo:app"},"data":{"github":"emmalabs/emma.db-data","path":"/home/aleix/Projects/emma.db/emma-data","base":"develop","label":"repo:data"},"docker":{"github":"emmalabs/emma.db-docker","path":"/home/aleix/Projects/emma.db/emma-docker","base":"develop","label":"repo:docker"}}

# Runtime safety.
MAX_ISSUES_PER_TICK=1
LOCK_DIR=.locks
DRY_RUN=true
TEST_COMMAND=
CODEX_MODEL=gpt-5.2-codex
CODEX_SANDBOX=workspace-write
