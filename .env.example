# Optional label gate. Leave empty to process any Todo issue.
LINEAR_READY_LABEL=
LINEAR_RUNNING_LABEL=agent-running
LINEAR_BLOCKED_LABEL=agent-blocked
LINEAR_TODO_STATUS=Todo
LINEAR_IN_PROGRESS_STATUS=In Progress
LINEAR_IN_REVIEW_STATUS=In Review
# Optional. When present, routine Linear polling/comments/status/labels use the fast GraphQL API.
# When empty, the orchestrator falls back to Linear MCP through Codex CLI.
LINEAR_API_KEY=

# Workspace allowlist keyed by Linear team key.
WORKSPACE_MAP_JSON={"ENG":{"path":"/Users/alex/Projects/product","repos":{"web":{"github":"example/product-web","path":"/Users/alex/Projects/product/web","base":"develop"},"api":{"github":"example/product-api","path":"/Users/alex/Projects/product/api","base":"main"}}}}

# Runtime safety.
MAX_ISSUES_PER_TICK=1
LOCK_DIR=.locks
DRY_RUN=false
TEST_COMMAND=
# Leave empty to use the default model supported by your local Codex login.
CODEX_MODEL=gpt-5.5
CODEX_REASONING_EFFORT=medium
CODEX_FAST_MODE=false
CODEX_SANDBOX=workspace-write
PR_FEEDBACK_BRANCH_PREFIX=codex/
